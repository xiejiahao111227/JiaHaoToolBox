<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>JiaHaoToolBox</AssemblyName>
    <Product>嘉豪工具箱</Product>
    <Title>嘉豪工具箱</Title>
    <PackageId>JiaHaoToolBox</PackageId>
    <Version>1.2.0</Version>
    <InformationalVersion>1.2.0-TEST+OS1.0.2.0.UMNMIXM</InformationalVersion>
    <Company>JiaHaoToolBox</Company>
    <Copyright>Copyright © 2026 嘉豪工具箱 contributors. Based on VioletToolBox (c) 泡菜 / Smart-Paocai, licensed under GPL-3.0-or-later.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>JiaHaoToolBox.ico</ApplicationIcon>
    <RuntimeConfigFile>$(MSBuildThisFileDirectory)single-line.runtimeconfig.json</RuntimeConfigFile>
   
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标与署名素材整体作为 WPF Resource 嵌入：SvgViewbox/Image 的相对 URI 解析到
         pack://application:,,,/images/xxx.svg，只复制到输出目录（Content/None）不会被打进程序集。
         用通配而不是逐条列举，避免新增图标时漏声明导致图标空白。 -->
    <None Remove="images\**\*" />
    <Resource Include="images\**\*" />
    <None Remove="wx.png" />
    <None Remove="zfb.png" />
    <Resource Include="wx.png" />
    <Resource Include="zfb.png" />
    <None Remove="single-line.runtimeconfig.json" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="JiaHaoToolBox.ico" />
    <None Update="Protos\update_metadata.proto">
      <GrpcServices>None</GrpcServices>
    </None>
    <None Update="QSaharaServer.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <!-- Official Release packages may provide these runtime tools separately. -->
    <Content Include="..\断点续传\aria2c.exe" Condition="Exists('..\断点续传\aria2c.exe')">
      <Link>exe\aria2c.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="exe\fix_usb3.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\avbtool\tools\pem\*.pem" Condition="Exists('..\avbtool\tools\pem')">
      <Link>avbtool\tools\pem\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="KernelPatch\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="LKM_Patch\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="single-line.runtimeconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
    <PackageReference Include="SharpCompress" Version="0.44.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
    <PackageReference Include="SharpEDL" Version="1.0.4" />
    <PackageReference Include="System.IO.Ports" Version="9.0.8" />
    <PackageReference Include="System.Management" Version="9.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>




  <ItemGroup>
    <ProjectReference Include="Payload_Dumper_C#\Payload_Dumper_C#.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Payload_Dumper_C#\**\*.cs" />
    <Page Remove="Payload_Dumper_C#\**\*.xaml" />
    <ApplicationDefinition Remove="Payload_Dumper_C#\**\*.xaml" />
  </ItemGroup>

  <!-- 上游项目（紫罗兰工具箱 / VioletToolBox）作者署名素材，用于关于页归属；
       images\ 目录内的头像与二维码已由上面的通配 Resource 覆盖 -->
  <ItemGroup>
    <Resource Include="paocai.jpg" />
    <Resource Include="neko.png" />
  </ItemGroup>
</Project>
 
