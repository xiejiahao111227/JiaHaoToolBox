<!-- 浅色液态玻璃语义画刷。键名与 Glass.Dark.xaml 一一对应，运行时整本替换即可完成深浅切换。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口底：预渲染光斑图，玻璃面板叠在其上 -->
    <ImageBrush x:Key="GlassBackdrop"
                ImageSource="pack://application:,,,/images/glass-light.png"
                Stretch="Fill" />

    <SolidColorBrush x:Key="GlassWindowBorder" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="GlassTitleBar" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="GlassNav" Color="#4CFFFFFF" />
    <SolidColorBrush x:Key="GlassNavSelected" Color="#332E7CD6" />
    <SolidColorBrush x:Key="GlassDivider" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassField" Color="#70FFFFFF" />

    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#5CFFFFFF" Offset="0" />
        <GradientStop Color="#30FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassSurfaceSoft" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassSurfaceBorder" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="GlassAccentBorder" Color="#99A7C8EA" />
    <SolidColorBrush x:Key="GlassChip" Color="#B3DCEBFA" />
    <SolidColorBrush x:Key="GlassPopup" Color="#F6FFFFFF" />

    <!-- 列表/表格的行态：隔行、悬停、选中、表头 -->
    <SolidColorBrush x:Key="GlassRowAlt" Color="#FFF9FBFE" />
    <SolidColorBrush x:Key="GlassRowHover" Color="#CCF1F9FF" />
    <SolidColorBrush x:Key="GlassSelection" Color="#FFC9E4F7" />
    <SolidColorBrush x:Key="GlassHeader" Color="#FFF2F6F9" />
    <SolidColorBrush x:Key="GlassDisabled" Color="#FFE6EBF0" />

    <SolidColorBrush x:Key="GlassTextPrimary" Color="#FF17202B" />
    <SolidColorBrush x:Key="GlassTextSecondary" Color="#FF55677A" />
    <SolidColorBrush x:Key="GlassAccent" Color="#FF2E7CD6" />
    <SolidColorBrush x:Key="GlassAccentSoft" Color="#332E7CD6" />
    <SolidColorBrush x:Key="GlassAccentText" Color="#FF1B5FB0" />
    <SolidColorBrush x:Key="GlassButtonPrimary" Color="#FF2E7CD6" />
    <SolidColorBrush x:Key="GlassButtonPrimaryHover" Color="#FF2668B8" />
    <SolidColorBrush x:Key="GlassOnAccent" Color="#FFF7FBFF" />

    <DropShadowEffect x:Key="GlassShadow"
                      Color="#FF12304F"
                      Opacity="0.16"
                      BlurRadius="22"
                      ShadowDepth="2"
                      Direction="270" />

    <!-- HandyControl 的画刷是冻结的，换颜色键不生效，只能在它之后整本覆盖画刷本身。
         Region/Border/Text 三组决定 ComboBox、TextBox、SideMenu 等控件的观感；
         RegionBrush 留九成不透明度，否则下拉弹层会透出桌面。 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2E7CD6" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#FFEAF3FD" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#FF1B5FB0" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF17202B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF55677A" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#FF8A97A5" />
    <SolidColorBrush x:Key="ReverseTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextIconBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#66C3D0DE" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#FFB2BAC2" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="RegionBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#E6F7FAFD" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="#D9EAF1F8" />

</ResourceDictionary>
