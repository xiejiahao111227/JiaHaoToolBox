<!-- 深色液态玻璃语义画刷。键名与 Glass.Light.xaml 一一对应，运行时整本替换即可完成深浅切换。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ImageBrush x:Key="GlassBackdrop"
                ImageSource="pack://application:,,,/images/glass-dark.png"
                Stretch="Fill" />

    <SolidColorBrush x:Key="GlassWindowBorder" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="GlassTitleBar" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassNav" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassDivider" Color="#1FFFFFFF" />
    <!-- 输入框在深色下用暗色薄纱，避免近白文字压在浅色块上 -->
    <SolidColorBrush x:Key="GlassField" Color="#4007111C" />

    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#30FFFFFF" Offset="0" />
        <GradientStop Color="#17FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassSurfaceSoft" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassSurfaceBorder" Color="#33FFFFFF" />

    <!-- 列表/表格的行态：隔行、悬停、选中、表头 -->
    <SolidColorBrush x:Key="GlassRowAlt" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="GlassRowHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="GlassSelection" Color="#596FB4FF" />
    <SolidColorBrush x:Key="GlassHeader" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassDisabled" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassAccentBorder" Color="#4DA8CCF0" />
    <SolidColorBrush x:Key="GlassChip" Color="#332A5680" />
    <SolidColorBrush x:Key="GlassPopup" Color="#F21E2B3A" />

    <SolidColorBrush x:Key="GlassTextPrimary" Color="#FFF2F6FC" />
    <SolidColorBrush x:Key="GlassTextSecondary" Color="#FFA9BACB" />
    <SolidColorBrush x:Key="GlassAccent" Color="#FF6FB4FF" />
    <SolidColorBrush x:Key="GlassAccentSoft" Color="#336FB4FF" />
    <SolidColorBrush x:Key="GlassAccentText" Color="#FF9CCBFF" />
    <!-- 主按钮在两套主题下都保持饱和蓝，白色文字才有足够对比度 -->
    <SolidColorBrush x:Key="GlassButtonPrimary" Color="#FF2A6FCC" />
    <SolidColorBrush x:Key="GlassButtonPrimaryHover" Color="#FF3F86DE" />
    <SolidColorBrush x:Key="GlassOnAccent" Color="#FFF7FBFF" />

    <DropShadowEffect x:Key="GlassShadow"
                      Color="#FF000000"
                      Opacity="0.5"
                      BlurRadius="24"
                      ShadowDepth="2"
                      Direction="270" />

    <!-- 与 Glass.Light.xaml 同步覆盖 HandyControl 画刷键，两本字典的键必须一一对应 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF6FB4FF" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#FF17364F" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#FF9CCBFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F6FC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA9BACB" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#FF7E8FA1" />
    <SolidColorBrush x:Key="ReverseTextBrush" Color="#FF17202B" />
    <SolidColorBrush x:Key="TextIconBrush" Color="#FF0D1420" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="RegionBrush" Color="#F218222E" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#E6202C3A" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="#D92A3A4D" />
</ResourceDictionary>
